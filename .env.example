# =============================================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA ZENIT
# =============================================================================
# Copia este archivo a .env y completa con tus valores reales
# NUNCA commits .env a control de versiones
# =============================================================================

# BASE DE DATOS
# =============================================================================
DATABASE_URL=mysql://user:password@localhost:3306/cerebro_editorial
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=cerebro_editorial

# SERVIDOR EXPRESS
# =============================================================================
PORT=3000
NODE_ENV=production
API_URL=http://localhost:3000

# WORDPRESS REST API
# =============================================================================
WORDPRESS_SITE_URL=https://tudominio.com
WORDPRESS_USERNAME=admin
WORDPRESS_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
WORDPRESS_SITE_NAME=Cerebro Editorial

# YOUTUBE DATA API
# =============================================================================
YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your-client-secret
YOUTUBE_REFRESH_TOKEN=your-refresh-token

# TIKTOK API
# =============================================================================
TIKTOK_CLIENT_KEY=your-client-key
TIKTOK_CLIENT_SECRET=your-client-secret
TIKTOK_ACCESS_TOKEN=your-access-token

# TWITTER/X API
# =============================================================================
TWITTER_API_KEY=your-api-key
TWITTER_API_SECRET=your-api-secret
TWITTER_ACCESS_TOKEN=your-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-access-token-secret
TWITTER_BEARER_TOKEN=your-bearer-token

# FACEBOOK / INSTAGRAM
# =============================================================================
FACEBOOK_PAGE_ID=your-page-id
FACEBOOK_ACCESS_TOKEN=your-access-token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-account-id
INSTAGRAM_ACCESS_TOKEN=your-access-token

# RUTAS Y DIRECTORIOS
# =============================================================================
# Ruta al perfil de Chrome/Chromium para Playwright
CHROME_PROFILE_PATH=~/.config/google-chrome/Default
# Directorio para logs y screenshots
LOG_DIR=./logs
SCREENSHOTS_DIR=./logs/screenshots

# CONFIGURACIÓN DEL BOT
# =============================================================================
# Intervalo de consulta de tareas (segundos)
BOT_POLL_INTERVAL=60
# Máximo de reintentos para operaciones fallidas
BOT_MAX_RETRIES=5
# Timeout para operaciones HTTP (segundos)
BOT_REQUEST_TIMEOUT=30

# CONFIGURACIÓN RSS
# =============================================================================
# Ruta al archivo de configuración de feeds RSS
RSS_FEEDS_CONFIG=./rss_feeds.json
# Intervalo de monitoreo RSS (segundos)
RSS_POLL_INTERVAL=3600

# CONFIGURACIÓN SEO
# =============================================================================
# Plugin SEO a utilizar (rankmath, yoast, native)
SEO_PLUGIN=rankmath
# Puntuación SEO mínima requerida
SEO_MIN_SCORE=70

# CONFIGURACIÓN DE INTERLINKING
# =============================================================================
# Máximo de enlaces internos por post
INTERLINKING_MAX_LINKS=5
# Puntuación mínima de relevancia para interlinking
INTERLINKING_MIN_RELEVANCE=0.6

# CONFIGURACIÓN PM2
# =============================================================================
# Nombre de la aplicación en PM2
PM2_APP_NAME=zenit-web
# Número de instancias (0 = número de CPUs)
PM2_INSTANCES=0
# Modo de ejecución (fork, cluster)
PM2_EXEC_MODE=cluster

# CONFIGURACIÓN DOCKER
# =============================================================================
DOCKER_REGISTRY=docker.io
DOCKER_IMAGE_NAME=cerebro-editorial
DOCKER_IMAGE_TAG=latest

# LOGGING Y MONITOREO
# =============================================================================
LOG_LEVEL=info
# Habilitar logging a archivo
LOG_TO_FILE=true
# Habilitar logging a consola
LOG_TO_CONSOLE=true

# SEGURIDAD
# =============================================================================
# Clave secreta para sesiones
SESSION_SECRET=your-super-secret-key-change-in-production
# Habilitar CORS
CORS_ENABLED=true
# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,https://tudominio.com

# CARACTERÍSTICAS EXPERIMENTALES
# =============================================================================
# Habilitar modo debug
DEBUG_MODE=false
# Habilitar capturas de pantalla en errores
ENABLE_SCREENSHOTS=true
# Habilitar validación SEO automática
ENABLE_SEO_VALIDATION=true
